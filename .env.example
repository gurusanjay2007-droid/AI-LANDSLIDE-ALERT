# Environment Configuration for Landslide Early Warning System

# Application Mode
APP_ENV=development
PORT=8000
DEBUG=True

# Google Earth Engine API
# In production, specify your GEE Service Account Key path and project ID
GEE_SERVICE_ACCOUNT=landslide-monitor-gee@earth-engine-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_FILE=./config/gee-private-key.json
GEE_PROJECT_ID=landslide-early-warning-3982

# Weather & Environmental APIs (IMD / Open-Meteo / NASA POWER)
WEATHER_API_KEY=mock_demo_weather_api_key_secure_2026
IMD_RADAR_ENDPOINT=https://mausam.imd.gov.in/api/radar
NASA_POWER_API_KEY=mock_nasa_power_token

# Database Configuration (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://disaster_admin:SecurePassword2026!@localhost:5432/landslide_monitoring_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=landslide_monitoring_db
DB_USER=disaster_admin
DB_PASSWORD=SecurePassword2026!

# JWT Authentication
JWT_SECRET_KEY=super_secret_jwt_landslide_warning_system_token_2026_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Alert Notification Gateways (SMS / WhatsApp / Siren)
TWILIO_ACCOUNT_SID=AC_mock_twilio_sid
TWILIO_AUTH_TOKEN=mock_twilio_token
NDMA_CAP_ALERT_ENDPOINT=https://cap.ndma.gov.in/api/v1/broadcast
